# Server
PORT=8787

# Comma-separated browser origins allowed to call the API.
# Leave the localhost defaults for development. In production, omit this
# so the API is same-origin only, unless the UI is on a separate host.
# For a split GitHub Pages + API deploy, add the Pages origin, for example:
# CORS_ORIGINS=https://datvanu.github.io
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Optional path to the Vite build. Default: apps/web/dist
# WEB_DIST_DIR=

# MCP stdio bridge (packages/mcp)
# PIPES_API_BASE=http://127.0.0.1:8787

# Ghost builder. Demo needs no API keys.
# Do not put any LLM API key in this file, in the repo, or on the host.
# The rule-based demo is always the default when no key is sent.
# GHOST_MODE=demo alone disables visitor-key forwarding.
# GHOST_ACCEPT_VISITOR_KEYS=true re-enables optional visitor keys even when
# GHOST_MODE=demo (this is what the hosted demo uses). Unset GHOST_MODE, or
# set it to "byok", to allow visitor keys without the extra flag.
GHOST_MODE=demo
GHOST_ACCEPT_VISITOR_KEYS=true

# Number of reverse-proxy hops to trust for request.ip / rate limits.
# Set to 1 on Render. Leave unset for local dev without a proxy.
# TRUST_PROXY=1

# Public HTTPS origin for absolute export links in production. Required once
# the hosted URL is known. Until then, production uses relative /p/:id links
# and does not trust Host or Forwarded headers.
# PUBLIC_BASE_URL=https://example.onrender.com

# Web build-time variables (Vite)
# Leave VITE_API_BASE empty when the API serves the UI or when using the Vite dev proxy.
# VITE_API_BASE=https://your-api.example.com
# VITE_BASE=/
