{
  "name": "pipes-from-the-grave",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev -w @pipes/server",
    "dev:mcp": "npm run dev -w @pipes/mcp",
    "dev:web": "npm run dev -w @pipes/web",
    "dev:all": "concurrently \"npm:dev:server\" \"npm:dev:web\"",
    "start": "npm run start -w @pipes/server"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^5.1.0",
    "concurrently": "^9.1.0",
    "vite": "^7.3.8"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  },
  "overrides": {
    "find-my-way": "^9.7.0",
    "fast-xml-parser": "^5.12.1"
  }
}
